    end

    subgraph "TUI"
        TUI_APP[loom-tui-app]
        TUI_CORE[loom-tui-core]
        TUI_THEME[loom-tui-theme]
    end

    subgraph "Cross-Cutting"
        FLAGS[loom-flags-core]
        ANALYTICS[loom-analytics-core]
        REDACT[loom-redact]
        SCIM[loom-scim]
    end

    %% Entry point connections
    LOOM_CLI --> LCLI_TOOLS
    LOOM_CLI --> LCLI_CONFIG
    LOOM_CLI --> LC_CORE
    LOOM_CLI --> LC_THREAD
    LOOM_CLI --> LLM_PROXY

    LOOM_SERVER --> LS_API
    LOOM_SERVER --> LS_AUTH
    LOOM_SERVER --> LS_DB
    LOOM_SERVER --> LC_CORE

    %% CLI feature connections
    LCLI_TOOLS --> LC_CORE
    LCLI_CONFIG --> LC_CONFIG
    LCREDS --> LC_SECRET
    LCLI_GIT --> LC_CORE
    LCLI_AC --> LCLI_GIT

    %% Server core connections
    LS_API --> LS_AUTH
    LS_API --> LS_DB
    LS_AUTH --> LC_CORE
    LS_DB --> LC_CONFIG
    LS_CONFIG --> LC_CONFIG

    %% LLM provider connections
    LLM_SERVICE --> LLM_PROXY
    LLM_SERVICE --> LLM_ANTHROPIC
    LLM_SERVICE --> LLM_OPENAI
    LLM_SERVICE --> LLM_VERTEX
    LLM_PROXY --> LC_HTTP
    LLM_ANTHROPIC --> LC_HTTP
    LLM_OPENAI --> LC_HTTP
    LLM_VERTEX --> LC_HTTP

    %% Auth provider connections
    LS_AUTH --> AUTH_DEVICE
    LS_AUTH --> AUTH_GITHUB
    LS_AUTH --> AUTH_GOOGLE
    LS_AUTH --> AUTH_MAGIC
    LS_AUTH --> AUTH_OKTA

    AUTH_GITHUB --> LC_HTTP
    AUTH_GOOGLE --> LC_HTTP
    AUTH_OKTA --> LC_HTTP
    AUTH_DEVICE --> LC_HTTP

    %% Server feature connections
    LS_API --> LS_WEAVCER
    LS_API --> LS_SCM
    LS_API --> LS_FLAGS
    LS_API --> LS_ANALYTICS

    LS_WEAVCER --> LS_K8S
    LS_WEAVCER --> LS_SECRETS
    LS_K8S --> LC_CORE
    LS_SECRETS --> LC_SECRET

    LS_SCM_MIRROR --> LS_SCM
    LS_SCM --> LC_CORE
    LS_GITHUB --> LC_HTTP

    %% Common library connections
    LC_THREAD --> LC_SECRET
    LC_HTTP --> LC_CONFIG

    %% TUI connections
    TUI_APP --> TUI_CORE
    TUI_APP --> TUI_THEME
    TUI_CORE --> LC_CORE

    %% Cross-cutting connections
    LS_FLAGS --> FLAGS
    LS_ANALYTICS --> ANALYTICS
    LS_LOGS --> REDACT


