graph TB
    subgraph "Entry Points"
        LOOM_CLI[loom-cli]
        LOOM_SERVER[loom-server]
    end

    subgraph "Common Libraries"
        LC_CORE[loom-common-core]
        LC_THREAD[loom-common-thread]
        LC_HTTP[loom-common-http]
        LC_CONFIG[loom-common-config]
        LC_SECRET[loom-common-secret]
        LC_I18N[loom-common-i18n]
        LC_SPOOL[loom-common-spool]
        LC_WEBHOOK[loom-common-webhook]
        LC_VERSION[loom-common-version]
    end

    subgraph "CLI Features"
        LCLI_TOOLS[loom-cli-tools]
        LCLI_CONFIG[loom-cli-config]
        LCREDS[loom-cli-credentials]
        LCLI_GIT[loom-cli-git]
        LCLI_AC[loom-cli-auto-commit]
        LCLI_ACP[loom-cli-acp]
        LCLI_SPOOL[loom-cli-spool]
    end

    subgraph "Server Core"
        LS_API[loom-server-api]
        LS_AUTH[loom-server-auth]
        LS_DB[loom-server-db]
        LS_CONFIG[loom-server-config]
        LS_LOGS[loom-server-logs]
        LS_JOBS[loom-server-jobs]
        LS_AUDIT[loom-server-audit]
        LS_EMAIL[loom-server-email]
    end

    subgraph "LLM Providers"
        LLM_PROXY[loom-server-llm-proxy]
        LLM_ANTHROPIC[loom-server-llm-anthropic]
        LLM_OPENAI[loom-server-llm-openai]
        LLM_VERTEX[loom-server-llm-vertex]
        LLM_SERVICE[loom-server-llm-service]
    end

    subgraph "Auth Providers"
        AUTH_DEVICE[loom-server-auth-devicecode]
        AUTH_GITHUB[loom-server-auth-github]
        AUTH_GOOGLE[loom-server-auth-google]
        AUTH_MAGIC[loom-server-auth-magiclink]
        AUTH_OKTA[loom-server-auth-okta]
    end

    subgraph "Server Features"
        LS_SCM[loom-server-scm]
        LS_SCM_MIRROR[loom-server-scm-mirror]
        LS_GITHUB[loom-server-github-app]
        LS_WEAVCER[loom-server-weaver]
